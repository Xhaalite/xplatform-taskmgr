{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "xplatform-taskmgr",
  "version": "0.1.0",
  "identifier": "com.local.xplatformtaskmgr",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "windows": [
      {
        "title": "xplatform-taskmgr",
        "width": 1200,
        "height": 760,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' http://localhost:1420"
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": []
  }
}
